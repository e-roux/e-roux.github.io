---
import { getCollection } from "astro:content";
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import CourseCard from "@components/CourseCard.astro";

// Fetch all categories
const categories = await getCollection("courses");
---

<StarlightPage frontmatter={{ title: 'Courses and certifications', template: 'splash' }} >
  <main class="max-w-6xl mx-auto px-4 py-8">
    
    {categories.map((category) => (
      <section class="mb-16">
        <h2 class="text-xl font-semibold mb-6 pb-2 border-b border-gray-200 dark:border-gray-700 text-gray-800 dark:text-gray-100">
          {category.data.name || category.data.category || 'Other'}
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-3 lg:grid-cols-4 gap-6">
          {category.data.content.map((course) => (
            <CourseCard
              name={course.name}
              desc={course.desc}
              img={course.img}
              link={course.link}
              ongoing={course.ongoing}
              certificate={course.certificate}
              lectureFrom={course["lecture-from"]}
            />
          ))}
        </div>
      </section>
    ))}
  </main>
</StarlightPage>
